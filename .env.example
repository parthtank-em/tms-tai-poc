# Copy to .env and fill in. See docs/TECH_STACK.md §7 and
# docs/FreightID_TAI_Integration_Findings.md §3 / §7.

# --- Database (Neon Postgres) ---------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Unpooled connection, used by the Prisma CLI. Migrations take a session-level
# advisory lock that Neon's pooler does not support.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# --- Inbound: TAI webhook auth (findings §3) -------------------------------
# TAI does not sign payloads, so this header is the whole security boundary.
# Treat it as a long random shared secret.
#
# Option 1 — static Authorization header. TAI sends this string verbatim.
TAI_WEBHOOK_AUTH_TOKEN="Bearer <long-random-secret>"
#
# Option 2 — HTTP Basic. If BOTH options are configured, Basic wins, matching
# TAI's own precedence.
#
# These two also serve as the admin UI login (see below), so they are required
# in practice even if you authenticate TAI with the static token above.
TAI_WEBHOOK_BASIC_USER="freightid"
TAI_WEBHOOK_BASIC_PASSWORD="<long-random-secret>"

# --- Admin UI login --------------------------------------------------------
# The /login page checks TAI_WEBHOOK_BASIC_USER + TAI_WEBHOOK_BASIC_PASSWORD.
# Reusing the webhook credential is a POC shortcut — split them before anyone
# outside the team gets an account.
#
# Signs the session cookie. Rotating it signs everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET="<32-random-bytes-base64url>"

# --- Outbound: TAI Public REST API (findings §4) ---------------------------
# A SEPARATE credential from the inbound webhook secret, sent as `x-api-key`.
# Used by use case 4 (security alerts). Without it, alerts are still recorded
# locally and queued, but every send attempt fails as unconfigured.
TAI_API_KEY="<x-api-key value>"
#
# Host only, no path — the client appends /PublicApi/Shipping/v2/... itself.
# Defaults to the beta host named in TAI's OpenAPI `servers` entry:
#   https://www.taibeta.net
# The findings doc §4 names production instead. Set this explicitly to be sure
# which environment you are writing to.
# TAI_API_BASE_URL="https://www.taicloud.net"

# --- Jumio identity verification (docs/Jumio_Implementation_Plan.md) --------
# Server-side only. None of these may be exposed to the browser except
# NEXT_PUBLIC_APP_URL, which is just this app's own origin.
#
# Credentials from the Jumio Customer Portal. The client secret is shown once.
JUMIO_CLIENT_ID="<client id>"
JUMIO_CLIENT_SECRET="<client secret>"
#
# Which Jumio datacenter the tenant lives in: amer-1 (US), emea-1 (EU),
# apac-1 (SGP). The auth/account/retrieval hosts are derived from it.
JUMIO_DATACENTER="amer-1"
#
# Override the derived hosts only if Jumio gave you different ones. Defaults:
#   https://auth.<dc>.jumio.ai/oauth2/token
#   https://account.<dc>.jumio.ai
#   https://retrieval.<dc>.jumio.ai
# JUMIO_AUTH_URL=
# JUMIO_API_BASE_URL=
# JUMIO_RETRIEVAL_BASE_URL=
#
# Workflow definition key from the Jumio portal — which capabilities run
# (ID + selfie + liveness for this POC).
JUMIO_WORKFLOW_KEY="<workflow key>"
#
# Workflow definition key for /jumio-dashboard/documents — uploading a
# supporting document (address proof, bank statement) and reading back what
# Jumio extracted. A DIFFERENT workflow from the one above: different credential
# category, different capabilities, and it must permit the API acquisition
# channel so FreightID can upload the file itself.
#
# Jumio's Doc Proof quickstart uses 10170. Confirm the key your tenant has
# enabled with your Jumio account manager rather than assuming it. Leave unset
# and the documents screen says so instead of failing at upload time.
# JUMIO_DOCUMENT_WORKFLOW_KEY="10170"
#
# Jumio does not sign callbacks, so this secret is the security boundary for
# /api/jumio/callback. It is appended to the callback URL we hand Jumio and
# compared in constant time on every delivery. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JUMIO_CALLBACK_SECRET="<32-random-bytes-base64url>"
#
# Public HTTPS URL Jumio posts callbacks to. localhost is not reachable from
# Jumio — use an ngrok/Cloudflare tunnel in development and set it here rather
# than hardcoding the temporary domain anywhere in source.
# Defaults to NEXT_PUBLIC_APP_URL + /api/jumio/callback.
# JUMIO_CALLBACK_URL="https://<tunnel>.ngrok-free.app/api/jumio/callback"
#
# Reject callbacks that do not come from Jumio's published IP ranges. Leave
# false behind a tunnel (the observed IP is the tunnel's); set true in a real
# deployment where the client address survives.
JUMIO_CALLBACK_ENFORCE_IP="false"
#
# This app's public origin, used to build the Web Client return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
#
# Optional. Identifies the integration in Jumio's request logs, and how long a
# Web Client link stays usable (Jumio's default applies when unset).
# JUMIO_USER_AGENT="FreightID FreightID-POC/1.0"
# JUMIO_TOKEN_LIFETIME="30m"

# --- Integration tests -----------------------------------------------------
# A THROWAWAY Neon branch for `npm run test:integration`. The suite writes and
# deletes rows, so it refuses to run if this is unset or equals DATABASE_URL.
# Create one with: neon branches create --name jumio-integration-tests
TEST_DATABASE_URL="postgresql://<user>:<password>@<branch-endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
#
# Consent location, required by Jumio on every account call. Country is ISO
# 3166-1 alpha-3 (USA, not US); state is required when the country is USA.
# Left unset, both are read from the platform's geolocation headers — set them
# explicitly when testing from a different country than the driver.
# JUMIO_CONSENT_COUNTRY="USA"
# JUMIO_CONSENT_STATE="CA"
#
# How the driver's camera reaches Jumio:
#   sdk       (default) embeds Jumio's Web SDK in our own page — the driver
#                       never leaves FreightID
#   redirect            navigates to Jumio's hosted Web Client
#
# One account call returns both handles (sdk.token and web.href), so this
# changes nothing about what we send Jumio or how results come back — only
# which half of the reply /api/jumio/start hands the browser. Read on the
# server; the NEXT_PUBLIC_ prefix is kept because the value is not a secret.
#
# "sdk" also needs the SDK acquisition channel enabled on the workflow in
# Jumio's Workflow Designer. Without it the account reply carries no sdk.token
# and the start call fails, naming the fix in the server log.
NEXT_PUBLIC_JUMIO_ACQUISITION_CHANNEL="sdk"
